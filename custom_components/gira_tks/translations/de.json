{
  "config": {
    "step": {
      "user": {
        "title": "Gira TKS-IP Gateway",
        "description": "Trage zuerst im Gira TKS-Assistenten unter Anlage einrichten > HomeServer / FacilityServer einrichten > HomeServer-Verbindungsdaten die IP-Adresse dieses Home Assistant-Systems und einen Benutzernamen samt Passwort ein. Notiere diese Zugangsdaten. Verwende hier anschließend genau dieselben Zugangsdaten. Das Gateway sendet die TCP-Meldungen an die eingetragene Home-Assistant-IP und den unten angegebenen Port.",
        "data": {
          "gateway_host": "IP-Adresse des TKS-IP-Gateways",
          "listen_port": "TCP-Port für Meldungen (Standard: 50050)",
          "username": "TKS-Benutzername",
          "password": "TKS-Passwort"
        }
      }
    },
    "error": {
      "invalid_gateway_host": "Bitte die IPv4-Adresse des Gateways eingeben (kein Hostname)."
    },
    "abort": {
      "already_configured": "Dieses Gateway ist bereits eingerichtet."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "SIP und Livevideo",
        "description": "SIP benötigt einen eigenen Teilnehmer, den du im Gira TKS-Assistenten unter TKS-Communicator einrichten anlegst. Verwende dessen SIP-Benutzername und Passwort hier; dies sind separate Zugangsdaten und nicht die HomeServer-Verbindungsdaten. Ein eigener Teilnehmer verhindert, dass eine bestehende SIP-Anmeldung verdrängt wird. Rufe ohne Video werden als Klingeln gemeldet, können in Home Assistant aber nicht angenommen werden (Audio wird nicht unterstützt). Die lokale IP muss vom Gateway erreichbar sein; leer bedeutet automatische Auswahl. Eine SIP-Kameravorschau kann unabhängig von einem Türruf gestartet werden.",
        "data": {
          "sip_enabled": "SIP-Teilnehmer aktivieren",
          "sip_username": "SIP-Benutzername",
          "sip_password": "SIP-Passwort (leer lassen, um das gespeicherte zu behalten)",
          "local_ip": "Lokale IP-Adresse (leer = automatisch)",
          "sip_port": "Lokaler SIP-Port",
          "media_port": "Lokaler H.264-RTP-Port",
          "auto_answer": "Gespräch automatisch annehmen",
          "tks_door_opener_enabled": "Schaltbuttons Türöffner und Licht anzeigen (verschlüsselter SIP-Kanal; das SIP-Konto muss vom Gateway zum Schalten berechtigt sein)"
        }
      }
    },
    "error": {
      "sip_credentials_required": "Für SIP werden Benutzername und Passwort benötigt.",
      "invalid_local_ip": "Bitte eine gültige IPv4-Adresse dieses Home-Assistant-Systems eingeben."
    }
  },
