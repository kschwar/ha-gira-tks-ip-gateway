{
  "config": {
    "step": {
      "user": {
        "title": "Gira TKS-IP Gateway",
        "description": "First, in the Gira TKS assistant, go to System setup > Set up HomeServer / FacilityServer > HomeServer connection data and enter the IP address of this Home Assistant system plus a user name and password. Note these credentials and enter exactly the same ones here. The gateway sends its TCP messages to the configured Home Assistant IP and the port below.",
        "data": {
          "gateway_host": "IP address of the TKS-IP gateway",
          "listen_port": "TCP port for messages (default: 50050)",
          "username": "TKS user name",
          "password": "TKS password"
        }
      }
    },
    "error": {
      "invalid_gateway_host": "Please enter the gateway's IPv4 address (not a host name)."
    },
    "abort": {
      "already_configured": "This gateway is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "SIP and live video",
        "description": "SIP needs a dedicated participant, created in the Gira TKS assistant under Set up TKS-Communicator. Enter that participant's SIP user name and password here; these are separate from the HomeServer connection data. A dedicated participant avoids displacing an existing SIP registration. Audio-only calls are reported as ringing but cannot be answered in Home Assistant (audio is not supported). The local IP must be reachable by the gateway; leave it empty for automatic selection. A SIP camera preview can be started independently of a door call.",
        "data": {
          "sip_enabled": "Enable SIP participant",
          "sip_username": "SIP user name",
          "sip_password": "SIP password (leave empty to keep the saved one)",
          "local_ip": "Local IP address (empty = automatic)",
          "sip_port": "Local SIP port",
          "media_port": "Local H.264 RTP port",
          "auto_answer": "Answer calls automatically",
          "tks_door_opener_enabled": "Show switching buttons: door opener, light, switching action of function key 1 (encrypted SIP channel; the SIP account must be allowed to switch by the gateway)"
        }
      }
    },
    "error": {
      "sip_credentials_required": "SIP requires a user name and password.",
      "invalid_local_ip": "Please enter a valid IPv4 address of this Home Assistant system.",
      "invalid_sip_username": "The SIP user name may only contain Latin-1 characters (letters, digits, umlauts)."
    }
